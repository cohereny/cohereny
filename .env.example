# Copy to .env and adjust. Every key here is a setting in api/config.py: a key
# it does not know makes the API refuse to start, so nothing else belongs in
# this file (tests/test_env_example.py).
# The runtime role from `python -m migrations.roles`, never the superuser or the
# owner of the tables: the API refuses to start as either (CHY-85).
DATABASE_URL=postgresql://cohereny_runtime:cohereny_runtime@localhost:5432/cohereny
REDIS_URL=redis://localhost:6379/0
# Base only. Each consumer surface is its own Authentik application below this
# (INFRA-92, ADR-031), so there are four issuers and four audiences; both maps
# are derived in kernel/surfaces.py. There is no OIDC_ISSUER and no
# OIDC_AUDIENCE any more -- a single value cannot name four.
OIDC_BASE_URL=https://auth.example.com/application/o
# Plain http here is accepted only with ENVIRONMENT=dev: that is for
# scripts/dev_issuer.py, the local stand-in for the identity provider.
# Which stage this process is: dev, test or prod. Unset means prod.
ENVIRONMENT=prod
# Serve /docs, /redoc and /openapi.json without authentication. The contracts in
# contracts/ document the API either way.
API_DOCS=false
# Emit token usage per model call in pilot runs (node_metrics events).
PILOT_NODE_METRICS=false
API_VERSION=0.1.0

# --- Model gateway (LiteLLM, OpenAI-compatible) ---
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=

# --- The key for run mappings (CHY-234) ---
# Seals each workflow run's placeholder mapping; the API does not start without
# one. Generate: python -c 'from kernel.mapping_cipher import generate_key; print(generate_key("k1"))'
# Keep it outside the database and its backups (CRYPTOGRAPHY.md).
PII_MAPPING_KEYS=
# Which models the gateway serves and the strictest data class each may see:
# a routing-config.yaml (see router/routing-config.yaml for the format).
# Empty uses that bundled file, which names the reference installation's models.
ROUTING_CONFIG=

# --- Langfuse (CHY-29) ---
# https, not http: Traefik answers plain http with 404 rather than redirecting,
# and the SDK swallows transport errors — that combination cost three weeks of
# traces in CHY-78. Guarded by tests/test_internal_urls.py.
LANGFUSE_HOST=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true
# Prompt and response into the trace. Off where even a self-hosted trace store
# is too much; field-level redaction is CHY-63.
LANGFUSE_CAPTURE_IO=true
LANGFUSE_ENVIRONMENT=development
