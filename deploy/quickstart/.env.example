# Quickstart settings. Copy to .env next to compose.yaml and change what you need;
# every value below is also the default, so the quickstart runs without a .env.

# --- Ports on your machine (bound to 127.0.0.1 only) ---
# The API, with its interactive documentation at http://127.0.0.1:8000/docs
API_PORT=8000
# The development identity provider; you fetch tokens here (README.md, step 1)
ISSUER_PORT=9010

# --- The model ---
# Pulled into the Ollama container on first start, about 1 GB. Runs on the CPU:
# Docker on a Mac has no access to the GPU, so answers take a few seconds.
# Another model must also be declared in routing-config.yaml
# (guides/your-own-model.md).
QUICKSTART_MODEL=qwen2.5:1.5b
# Any OpenAI-compatible endpoint (path ending in /v1). The default is the Ollama
# container. Ollama running on your machine instead, with GPU:
#   MODEL_GATEWAY_URL=http://host.docker.internal:11434/v1
MODEL_GATEWAY_URL=http://ollama:11434/v1
# Sent as "Authorization: Bearer <key>" when set. Ollama needs none.
MODEL_GATEWAY_KEY=

# --- The database ---
# Only reachable inside the Compose network. Change it before the first start;
# afterwards the database keeps the old one until `docker compose down -v`.
POSTGRES_PASSWORD=cohereny
# The two roles Cohereny itself uses (CHY-85): the migration role owns the
# tables, the API runs as the runtime role. Set again on every start, so a
# change takes effect with the next `docker compose up`.
COHERENY_MIGRATOR_PASSWORD=cohereny_migrator
COHERENY_RUNTIME_PASSWORD=cohereny_runtime

# --- The key for run mappings ---
# A workflow run is stored with placeholders, and the mapping back to the real
# values is encrypted with this key (CHY-234). The default below is 32 zero
# bytes -- it works and protects nothing. For data that matters, generate one
# and keep it outside the database; a lost key takes the values with it:
#   docker compose run --rm api python -c "from kernel.mapping_cipher import generate_key; print(generate_key('k1'))"
PII_MAPPING_KEYS=quickstart:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# --- The example ---
# false starts with an empty database: no scopes, no rules, no workflow.
QUICKSTART_SEED=true
